<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:infra="clr-namespace:JsonEditor.Infrastructure"
                    xmlns:models="clr-namespace:JsonEditor.Models">

    <!-- ═══════════════════════════════════════════════════════════════════
         DJI DESIGN SYSTEM TOKENS (from DESIGN-dji.md)
         ═══════════════════════════════════════════════════════════════════ -->

    <!-- Brand & Action Colors -->
    <Color x:Key="DjiPrimaryColor">#0070D5</Color>
    <Color x:Key="DjiStoreBlueColor">#0060EF</Color>
    <Color x:Key="DjiStoreBlueTintColor">#DEEAFD</Color>
    <Color x:Key="DjiLinkBlueColor">#1890FF</Color>
    <Color x:Key="DjiTierOrangeColor">#BE4E04</Color>
    <Color x:Key="DjiBadgeOrangeColor">#FA8C16</Color>
    <Color x:Key="DjiErrorColor">#F5222D</Color>

    <!-- Surface Colors -->
    <Color x:Key="DjiCanvasColor">#FFFFFF</Color>
    <Color x:Key="DjiCanvasSoftColor">#F7F9FA</Color>
    <Color x:Key="DjiPanelColor">#F6F8F9</Color>
    <Color x:Key="DjiFogColor">#F5F5F5</Color>
    <Color x:Key="DjiAnnounceColor">#FAFAFA</Color>
    <Color x:Key="DjiFooterColor">#272727</Color>
    <Color x:Key="DjiFooterPillColor">#383838</Color>

    <!-- Text / Ink Colors -->
    <Color x:Key="DjiInkColor">#262626</Color>
    <Color x:Key="DjiInkSecondaryColor">#595959</Color>
    <Color x:Key="DjiInkTertiaryColor">#8C8C8C</Color>
    <Color x:Key="DjiStoreInkColor">#333333</Color>
    <Color x:Key="DjiGraphiteColor">#3B3E40</Color>
    <Color x:Key="DjiNavInkColor">#303233</Color>
    <Color x:Key="DjiSlateColor">#6C7073</Color>
    <Color x:Key="DjiSteelColor">#9FA3A6</Color>

    <!-- Border & Line Colors -->
    <Color x:Key="DjiHairlineColor">#F0F0F0</Color>
    <Color x:Key="DjiDividerColor">#E8E8E8</Color>
    <Color x:Key="DjiCardBorderColor">#D9D9D9</Color>
    <Color x:Key="DjiInputBorderColor">#D4D7D9</Color>
    <Color x:Key="DjiControlBorderColor">#CCCCCC</Color>

    <!-- SolidColorBrushes -->
    <SolidColorBrush x:Key="DjiPrimaryBrush" Color="{StaticResource DjiPrimaryColor}" />
    <SolidColorBrush x:Key="DjiStoreBlueBrush" Color="{StaticResource DjiStoreBlueColor}" />
    <SolidColorBrush x:Key="DjiStoreBlueTintBrush" Color="{StaticResource DjiStoreBlueTintColor}" />
    <SolidColorBrush x:Key="DjiLinkBlueBrush" Color="{StaticResource DjiLinkBlueColor}" />
    <SolidColorBrush x:Key="DjiTierOrangeBrush" Color="{StaticResource DjiTierOrangeColor}" />
    <SolidColorBrush x:Key="DjiBadgeOrangeBrush" Color="{StaticResource DjiBadgeOrangeColor}" />
    <SolidColorBrush x:Key="DjiErrorBrush" Color="{StaticResource DjiErrorColor}" />
    <SolidColorBrush x:Key="DjiErrorTintBrush" Color="#FFF1F0" />
    <SolidColorBrush x:Key="DjiWarningTintBrush" Color="#FFF7E6" />
    <SolidColorBrush x:Key="DjiSuccessGreenBrush" Color="#138A36" />
    <SolidColorBrush x:Key="DjiSuccessTintBrush" Color="#EBF9EE" />

    <SolidColorBrush x:Key="DjiCanvasBrush" Color="{StaticResource DjiCanvasColor}" />
    <SolidColorBrush x:Key="DjiCanvasSoftBrush" Color="{StaticResource DjiCanvasSoftColor}" />
    <SolidColorBrush x:Key="DjiPanelBrush" Color="{StaticResource DjiPanelColor}" />
    <SolidColorBrush x:Key="DjiFogBrush" Color="{StaticResource DjiFogColor}" />
    <SolidColorBrush x:Key="DjiAnnounceBrush" Color="{StaticResource DjiAnnounceColor}" />
    <SolidColorBrush x:Key="DjiFooterBrush" Color="{StaticResource DjiFooterColor}" />
    <SolidColorBrush x:Key="DjiFooterPillBrush" Color="{StaticResource DjiFooterPillColor}" />

    <SolidColorBrush x:Key="DjiInkBrush" Color="{StaticResource DjiInkColor}" />
    <SolidColorBrush x:Key="DjiInkSecondaryBrush" Color="{StaticResource DjiInkSecondaryColor}" />
    <SolidColorBrush x:Key="DjiInkTertiaryBrush" Color="{StaticResource DjiInkTertiaryColor}" />
    <SolidColorBrush x:Key="DjiStoreInkBrush" Color="{StaticResource DjiStoreInkColor}" />
    <SolidColorBrush x:Key="DjiGraphiteBrush" Color="{StaticResource DjiGraphiteColor}" />
    <SolidColorBrush x:Key="DjiNavInkBrush" Color="{StaticResource DjiNavInkColor}" />
    <SolidColorBrush x:Key="DjiSlateBrush" Color="{StaticResource DjiSlateColor}" />
    <SolidColorBrush x:Key="DjiSteelBrush" Color="{StaticResource DjiSteelColor}" />

    <SolidColorBrush x:Key="DjiHairlineBrush" Color="{StaticResource DjiHairlineColor}" />
    <SolidColorBrush x:Key="DjiDividerBrush" Color="{StaticResource DjiDividerColor}" />
    <SolidColorBrush x:Key="DjiCardBorderBrush" Color="{StaticResource DjiCardBorderColor}" />
    <SolidColorBrush x:Key="DjiInputBorderBrush" Color="{StaticResource DjiInputBorderColor}" />
    <SolidColorBrush x:Key="DjiControlBorderBrush" Color="{StaticResource DjiControlBorderColor}" />

    <!-- Font Families -->
    <FontFamily x:Key="DjiFontFamily">Open Sans, Malgun Gothic, Segoe UI</FontFamily>
    <FontFamily x:Key="DjiMonoFontFamily">Cascadia Mono, Consolas, Malgun Gothic</FontFamily>

    <!-- Converters -->
    <infra:BoolToVisibilityConverter x:Key="BoolToVis" />
    <infra:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />

    <!-- ═══════════════════════════════════════════════════════════════════
         DJI BUTTON STYLES (Pill Geometry)
         ═══════════════════════════════════════════════════════════════════ -->

    <Style x:Key="DjiPrimaryPillButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource DjiPrimaryBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontFamily" Value="{StaticResource DjiFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="16,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="pillBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="20"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="pillBorder" Property="Background" Value="{StaticResource DjiStoreBlueBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="pillBorder" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DjiStoreBuyPillButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource DjiStoreBlueBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontFamily" Value="{StaticResource DjiFontFamily}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="24,9" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="pillBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="22"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="pillBorder" Property="Background" Value="{StaticResource DjiPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="pillBorder" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DjiStoreCartPillButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource DjiStoreBlueTintBrush}" />
        <Setter Property="Foreground" Value="{StaticResource DjiStoreBlueBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource DjiFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="18,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="pillBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="20"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="pillBorder" Property="Background" Value="#C8DDFC" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="pillBorder" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DjiOutlinePillButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource DjiInkBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DjiInkBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource DjiFontFamily}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="pillBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="18"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="pillBorder" Property="Background" Value="{StaticResource DjiFogBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DjiSoftPillButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource DjiFogBrush}" />
        <Setter Property="Foreground" Value="{StaticResource DjiInkBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DjiCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource DjiFontFamily}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="pillBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="14"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="pillBorder" Property="BorderBrush" Value="{StaticResource DjiPrimaryBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource DjiPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DjiStepperButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource DjiCanvasSoftBrush}" />
        <Setter Property="Foreground" Value="{StaticResource DjiStoreInkBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DjiControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="32" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="stepBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="stepBorder" Property="Background" Value="{StaticResource DjiStoreBlueTintBrush}" />
                            <Setter TargetName="stepBorder" Property="BorderBrush" Value="{StaticResource DjiStoreBlueBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource DjiStoreBlueBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DjiInputTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource DjiCanvasBrush}" />
        <Setter Property="Foreground" Value="{StaticResource DjiInkBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DjiInputBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource DjiFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="9,5" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="txtBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="txtBorder" Property="BorderBrush" Value="{StaticResource DjiStoreBlueBrush}" />
                            <Setter TargetName="txtBorder" Property="BorderThickness" Value="1.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DjiToggleSwitch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="track"
                                Width="48"
                                Height="26"
                                CornerRadius="13"
                                Background="#D4D7D9"
                                Padding="3">
                            <Border x:Name="thumb"
                                    Width="20"
                                    Height="20"
                                    CornerRadius="10"
                                    Background="White"
                                    HorizontalAlignment="Left" />
                        </Border>
                        <TextBlock x:Name="stateLabel"
                                   Text="false"
                                   FontFamily="{StaticResource DjiMonoFontFamily}"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource DjiInkSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="{StaticResource DjiPrimaryBrush}" />
                            <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="stateLabel" Property="Text" Value="true" />
                            <Setter TargetName="stateLabel" Property="Foreground" Value="{StaticResource DjiPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════
         DJI GRIDSPLITTER STYLES (Vertical & Horizontal Resize Handles)
         ═══════════════════════════════════════════════════════════════════ -->
    <Style x:Key="DjiVerticalGridSplitter" TargetType="GridSplitter">
        <Setter Property="Width" Value="12" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="SizeWE" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridSplitter">
                    <Grid Background="Transparent">
                        <!-- Vertical Hairline Guide -->
                        <Border x:Name="splitLine"
                                Width="2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Stretch"
                                Margin="0,10"
                                CornerRadius="1"
                                Background="{StaticResource DjiDividerBrush}" />
                        <!-- Center Pill Grab Handle -->
                        <Border x:Name="grabPill"
                                Width="6"
                                Height="46"
                                CornerRadius="3"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{StaticResource DjiCardBorderBrush}"
                                BorderBrush="{StaticResource DjiCanvasBrush}"
                                BorderThickness="1" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="splitLine" Property="Background" Value="{StaticResource DjiPrimaryBrush}" />
                            <Setter TargetName="grabPill" Property="Background" Value="{StaticResource DjiPrimaryBrush}" />
                            <Setter TargetName="grabPill" Property="Height" Value="60" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="splitLine" Property="Background" Value="{StaticResource DjiStoreBlueBrush}" />
                            <Setter TargetName="grabPill" Property="Background" Value="{StaticResource DjiStoreBlueBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DjiHorizontalGridSplitter" TargetType="GridSplitter">
        <Setter Property="Height" Value="12" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="SizeNS" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridSplitter">
                    <Grid Background="Transparent">
                        <!-- Horizontal Hairline Guide -->
                        <Border x:Name="splitLine"
                                Height="2"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Margin="10,0"
                                CornerRadius="1"
                                Background="{StaticResource DjiDividerBrush}" />
                        <!-- Center Pill Grab Handle -->
                        <Border x:Name="grabPill"
                                Width="46"
                                Height="6"
                                CornerRadius="3"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{StaticResource DjiCardBorderBrush}"
                                BorderBrush="{StaticResource DjiCanvasBrush}"
                                BorderThickness="1" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="splitLine" Property="Background" Value="{StaticResource DjiPrimaryBrush}" />
                            <Setter TargetName="grabPill" Property="Background" Value="{StaticResource DjiPrimaryBrush}" />
                            <Setter TargetName="grabPill" Property="Width" Value="60" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="splitLine" Property="Background" Value="{StaticResource DjiStoreBlueBrush}" />
                            <Setter TargetName="grabPill" Property="Background" Value="{StaticResource DjiStoreBlueBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════
         RECURSIVE DATA TEMPLATE FOR ANY JSON TREE NODE IN STRUCTURED EDITOR
         ═══════════════════════════════════════════════════════════════════ -->
    <DataTemplate x:Key="JsonNodeEditorCardTemplate" DataType="{x:Type models:JsonTreeNode}">
        <Border x:Name="cardRoot"
                Background="{StaticResource DjiCanvasBrush}"
                BorderBrush="{StaticResource DjiCardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Margin="0,0,0,8"
                ClipToBounds="True">
            <Grid>
                <!-- Corner Badge if Modified (#fa8c16) -->
                <Border Background="{StaticResource DjiBadgeOrangeBrush}"
                        CornerRadius="0,7,0,8"
                        Padding="7,1.5"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Panel.ZIndex="4"
                        Visibility="{Binding IsModified, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="MODIFIED"
                               Foreground="White"
                               FontSize="9.5"
                               FontWeight="SemiBold" />
                </Border>

                <StackPanel Margin="14,10,14,10">
                    <!-- Top Header Row: Key / Type Badge / Value Editor / Node Actions -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Column 0: Type Badge + Key Name + Path -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <TextBlock Text="{Binding TypeBadge}"
                                           Foreground="{StaticResource DjiTierOrangeBrush}"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           Margin="0,0,8,0" />
                                <TextBlock Text="{Binding JsonPath}"
                                           Foreground="{StaticResource DjiInkTertiaryBrush}"
                                           FontFamily="{StaticResource DjiMonoFontFamily}"
                                           FontSize="10.5"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <TextBlock Text="{Binding DisplayTitle}"
                                       Foreground="{StaticResource DjiStoreInkBrush}"
                                       FontFamily="{StaticResource DjiMonoFontFamily}"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Column 1: Value Control (for Scalars) OR Container Summary -->
                        <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">

                            <!-- Boolean Switch -->
                            <CheckBox IsChecked="{Binding BoolValue, Mode=TwoWay}"
                                      Style="{StaticResource DjiToggleSwitch}"
                                      Visibility="{Binding IsBoolean, Converter={StaticResource BoolToVis}}" />

                            <!-- Numeric Stepper (INT / FLOAT) -->
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding IsNumeric, Converter={StaticResource BoolToVis}}">
                                <Button Content="−"
                                        Style="{StaticResource DjiStepperButton}"
                                        Command="{Binding StepDownCommand}" />
                                <TextBox Width="160"
                                         Margin="5,0"
                                         Style="{StaticResource DjiInputTextBox}"
                                         FontFamily="{StaticResource DjiMonoFontFamily}"
                                         FontWeight="SemiBold"
                                         TextAlignment="Center"
                                         Text="{Binding StringValue, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Content="+"
                                        Style="{StaticResource DjiStepperButton}"
                                        Command="{Binding StepUpCommand}" />
                            </StackPanel>

                            <!-- String / Null Input (+ Automatic File / Folder Browse Buttons) -->
                            <Grid Visibility="{Binding IsStringOrNull, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Style="{StaticResource DjiInputTextBox}"
                                         FontFamily="{StaticResource DjiMonoFontFamily}"
                                         Text="{Binding StringValue, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="문자열 입력 시 역슬래시(\)와 따옴표는 JSON 포맷에 맞게 자동 이스케이프(\\) 처리됩니다." />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="파일 선택..."
                                            Style="{StaticResource DjiOutlinePillButton}"
                                            Margin="6,0,0,0"
                                            Command="{Binding BrowseFileCommand}"
                                            Visibility="{Binding IsFilePathLike, Converter={StaticResource BoolToVis}}" />
                                    <Button Content="폴더 선택..."
                                            Style="{StaticResource DjiOutlinePillButton}"
                                            Margin="6,0,0,0"
                                            Command="{Binding BrowseFolderCommand}"
                                            Visibility="{Binding IsFolderPathLike, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Grid>

                            <!-- Container Summary + Quick Add Array Item -->
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding IsContainer, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding ValuePreview}"
                                           Foreground="{StaticResource DjiInkSecondaryBrush}"
                                           FontFamily="{StaticResource DjiMonoFontFamily}"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="360" />
                                <Button Content="내부로 이동 ›"
                                        Style="{StaticResource DjiSoftPillButton}"
                                        Foreground="{StaticResource DjiPrimaryBrush}"
                                        Margin="10,0,0,0"
                                        Command="{Binding DataContext.SelectNodeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="+ 원소 복제 추가"
                                        Style="{StaticResource DjiSoftPillButton}"
                                        Margin="6,0,0,0"
                                        Command="{Binding AddArrayItemCommand}"
                                        Visibility="{Binding IsArray, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Grid>

                        <!-- Column 2: Item Manipulation Buttons (Revert / Move / Duplicate / Delete) -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="원래대로"
                                    Style="{StaticResource DjiSoftPillButton}"
                                    Command="{Binding RevertCommand}"
                                    Visibility="{Binding IsModified, Converter={StaticResource BoolToVis}}"
                                    ToolTip="{Binding OriginalValueSummary}"
                                    Margin="0,0,4,0" />
                            <Button Content="▲"
                                    Style="{StaticResource DjiSoftPillButton}"
                                    Padding="7,3"
                                    ToolTip="위로 이동"
                                    Command="{Binding MoveUpCommand}"
                                    Margin="0,0,3,0" />
                            <Button Content="▼"
                                    Style="{StaticResource DjiSoftPillButton}"
                                    Padding="7,3"
                                    ToolTip="아래로 이동"
                                    Command="{Binding MoveDownCommand}"
                                    Margin="0,0,3,0" />
                            <Button Content="복제"
                                    Style="{StaticResource DjiSoftPillButton}"
                                    ToolTip="동일 구조로 바로 아래에 복제"
                                    Command="{Binding DuplicateSelfCommand}"
                                    Margin="0,0,3,0" />
                            <Button Content="✕"
                                    Style="{StaticResource DjiSoftPillButton}"
                                    Foreground="{StaticResource DjiErrorBrush}"
                                    Padding="7,3"
                                    ToolTip="이 항목 삭제"
                                    Command="{Binding DeleteSelfCommand}" />
                        </StackPanel>
                    </Grid>

                    <!-- Inline Recursive Expansion for Container Nodes (Objects / Arrays) -->
                    <Expander IsExpanded="{Binding IsInlineExpanded}"
                              Header="하위 항목 펼쳐보기 / 접기"
                              Foreground="{StaticResource DjiInkSecondaryBrush}"
                              FontSize="11.5"
                              Margin="0,6,0,0"
                              Visibility="{Binding IsContainer, Converter={StaticResource BoolToVis}}">
                        <Border Background="{StaticResource DjiCanvasSoftBrush}"
                                BorderBrush="{StaticResource DjiDividerBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,8"
                                Margin="0,6,0,0">
                            <ItemsControl ItemsSource="{Binding Children}" />
                        </Border>
                    </Expander>

                    <!-- Validation Error Banner -->
                    <Border Background="{StaticResource DjiErrorTintBrush}"
                            BorderBrush="{StaticResource DjiErrorBrush}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="8,4"
                            Margin="0,6,0,0"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding ValidationError}"
                                   Foreground="{StaticResource DjiErrorBrush}"
                                   FontSize="11.5"
                                   FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding HasError}" Value="True">
                <Setter TargetName="cardRoot" Property="BorderBrush" Value="{StaticResource DjiErrorBrush}" />
                <Setter TargetName="cardRoot" Property="BorderThickness" Value="2" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsModified}" Value="True">
                <Setter TargetName="cardRoot" Property="BorderBrush" Value="{StaticResource DjiStoreBlueBrush}" />
                <Setter TargetName="cardRoot" Property="BorderThickness" Value="1.5" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSearchMatch}" Value="True">
                <Setter TargetName="cardRoot" Property="Background" Value="#FFFBE6" />
                <Setter TargetName="cardRoot" Property="BorderBrush" Value="{StaticResource DjiBadgeOrangeBrush}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Implicit DataTemplate for JsonTreeNode so recursive Children render automatically -->
    <DataTemplate DataType="{x:Type models:JsonTreeNode}">
        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource JsonNodeEditorCardTemplate}" />
    </DataTemplate>

</ResourceDictionary>
